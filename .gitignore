# ==========================================
# Python / FastAPI / Virtual Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/
.env

# ==========================================
# PyInstaller & Backend Build Output
# ==========================================
build/
dist/
*.manifest
*.spec
backend/dist/
backend/build/

# ==========================================
# Database & Temp Files
# ==========================================
*.db
*.sqlite
*.sqlite3
sync_state.json

# Keep uploads directory structure, but ignore uploaded images/files
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
backend/uploads/temp/*
!backend/uploads/temp/.gitkeep

# ==========================================
# Node.js / React Frontend
# ==========================================
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.eslintcache

# ==========================================
# Tauri / Rust Build Artifacts & Sidecar Binaries
# ==========================================
src-tauri/target/
frontend/src-tauri/target/
*.exe
*.dll
*.so
*.dylib
# Ignore compiled sidecar binaries, keep directories
frontend/src-tauri/binaries/*.exe

# ==========================================
# AI Models & Local Heavy Files
# ==========================================
*.bin
*.safetensors
*.gguf
.ollama/

# ==========================================
# IDE & Operating System Files
# ==========================================
.vscode/
.idea/
*.log
.DS_Store
Thumbs.db