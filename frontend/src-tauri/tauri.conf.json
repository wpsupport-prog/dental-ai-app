{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DentalAISuite",
  "version": "1.0.0",
  "identifier": "com.dentalai.suite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dental AI Intake Suite",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "maximized": true
      }
    ]
  },
	"bundle": {
	  "active": true,
	  "targets": ["msi"],
	  "resources": [
		"resources/lib/"
	  ],
	  "icon": [
		"icons/32x32.png",
		"icons/128x128.png",
		"icons/128x128@2x.png",
		"icons/icon.icns",
		"icons/icon.ico"
	  ],
	  "externalBin": [
		"binaries/dental-backend",
		"binaries/ollama"
	  ]
	}
}